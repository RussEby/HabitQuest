# ============================================================
#  Habit Quest — only source code belongs in this repository.
# ============================================================

# --- Local save files -------------------------------------
# Your hero is yours, not the repo's. Delete the file to start over.
habitquest.db
habitquest.db-wal
habitquest.db-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---------------------------------
.venv/
venv/
env/
ENV/

# --- Test / lint caches -----------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Logs and temp output ---------------------------------
*.log
*.tmp
nohup.out

# --- Editor and tooling metadata --------------------------
# .freebuff/ holds agent/IDE bookkeeping, not source.
.freebuff/
.vscode/
.idea/
*.swp
*.swo

# --- Desktop app (Electron) --------------------------------
node_modules/
desktop/out/
desktop/release/
# Old staging folder used by early builds of scripts/build-install.ps1.
desktop/release-bundle/
desktop/backend-dist/
# The app icon is source, not build output (the generic build/ rule above
# would otherwise swallow it).
!desktop/build/
!desktop/build/icon.png

# --- Patch and scratch leftovers ---------------------------
# Merge/patch byproducts and ad-hoc repair scripts never belong in a commit.
*.orig
*.fixed
*.rej
*.bak
*.patch
scratch-*

# --- OS cruft ---------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
